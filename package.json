{
  "name": "@oc-forge/openchamber-cloak-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CloakBrowser in OpenChamber: a browser on the server that you and the agent share.",
  "license": "MIT",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.6.0"
    },
    "contributes": {
      "panel": {
        "id": "oc-forge-cloak-browser",
        "name": "Cloak Browser",
        "icon": "shield-user",
        "entry": "panel/index.html",
        "dock": "top",
        "size": 40
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "surface": true
      }
    }
  },
  "scripts": {
    "check": "tsc -p .",
    "build": "bun run build:panel && bun run build:service",
    "build:panel": "openchamber-guest-bundle panel/main.ts panel/main.js",
    "build:service": "openchamber-guest-bundle --node service/main.ts service/main.js"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.6.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
